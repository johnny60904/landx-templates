<Project>
  <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
  <Target Name="ValidateTargetFramework" BeforeTargets="Build">
    <!--#if (IsTfm8) -->
<!--/-:msbuild-conditional:noEmit -->
    <Error Text="[Build Error] TargetFramework must be 'net8.0', but was: '$(TargetFramework)'."
      Condition="'$(TargetFramework)' != 'net8.0'" />
<!--/+:msbuild-conditional:noEmit -->
    <!--#elseif (IsTfm9) -->
    <!--/-:msbuild-conditional:noEmit -->
    <Error Text="[Build Error] TargetFramework must be 'net9.0', but was: '$(TargetFramework)'."
      Condition="'$(TargetFramework)' != 'net9.0'" />
<!--/+:msbuild-conditional:noEmit -->
    <!--#elseif (IsTfm10) -->
<!--/-:msbuild-conditional:noEmit -->
    <Error Text="[Build Error] TargetFramework must be 'net10.0', but was: '$(TargetFramework)'."
      Condition="'$(TargetFramework)' != 'net10.0'" />
<!--/+:msbuild-conditional:noEmit -->
    <!--#elseif (IsTfm11) -->
<!--/-:msbuild-conditional:noEmit -->
    <Error Text="[Build Error] TargetFramework must be 'net11.0', but was: '$(TargetFramework)'."
      Condition="'$(TargetFramework)' != 'net11.0'" />
<!--/+:msbuild-conditional:noEmit -->
    <!--#endif -->
    <Message Importance="high" Text="Validation for target framework." />
  </Target>
</Project>