<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>__TargetFramework__</TargetFramework>
    <!--#if (!BuildConfig && Preset != 'full') -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--#endif -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--#if (Version == 'latest' || Version == 'sts' || Version == '11' || Version == '11.0' || VersionSdkVersion == '11.0.100' || NormalizedSdkVersion == '11.0.100') -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <OutputType>Exe</OutputType>
    <!--#endif -->
  </PropertyGroup>

  <!--#if (BuildConfig || Preset == 'full') -->
  <ItemGroup>
    <!--#if (Version == 'latest' || Version == 'sts' || Version == '11' || Version == '11.0' || VersionSdkVersion == '11.0.100' || NormalizedSdkVersion == '11.0.100') -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage"/>
    <!--#else -->
    <PackageReference Include="coverlet.collector"/>
    <!--#endif -->
    <PackageReference Include="FluentAssertions"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <!--#else -->
  <ItemGroup>
    <!--#if (Version == 'latest' || Version == 'sts' || Version == '11' || Version == '11.0' || VersionSdkVersion == '11.0.100' || NormalizedSdkVersion == '11.0.100') -->
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!--#else -->
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <!--#endif -->
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <!--#endif -->

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MyNamespace.MyProject\MyNamespace.MyProject.csproj" />
  </ItemGroup>

</Project>