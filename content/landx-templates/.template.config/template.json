{
  "$schema": "https://json.schemastore.org/template",
  "author": "LanDX",
  "classifications": [
    "Library",
    "C#",
    "Solution"
  ],
  "identity": "LanDX.Templates",
  "name": "LanDX Templates",
  "shortName": "landx-templates",
  "sourceName": "MyNamespace.MyProject",
  "preferNameDirectory": true,
  "guids": [
    "827E0CD3-B72D-47B6-A68D-7590B98EB39B",
    "11D4CD90-F4BF-4383-BFFF-3CA2901ED205",
    "0AB3BF05-4346-4AA6-1389-037BE0695223",
    "080E95A5-7A46-4E4C-992F-13DCD0F51C5C",
    "66320409-64EC-F7C5-3DEF-65E7510DAAD1",
    "A3852942-941B-436A-89DB-CE7C6BA9DCFB"
  ],
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "ProjectType": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "classlib",
      "description": "Main project type",
      "choices": [
        {
          "choice": "classlib",
          "description": "Class Library (recommended)"
        },
        {
          "choice": "class",
          "description": "Class Library alias"
        },
        {
          "choice": "lib",
          "description": "Class Library alias"
        },
        {
          "choice": "console",
          "description": "Console Application"
        }
      ]
    },
    "Simple": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Generate only the main project"
    },
    "Benchmarks": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include BenchmarkDotNet project"
    },
    "Docs": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include documentation"
    },
    "GitHubActions": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include GitHub Actions workflow"
    },
    "SdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "description": "Required .NET SDK version for global.json and generating corresponding solution file (.sln or .slnx)",
      "isRequired": true
    },
    "NormalizedSdkVersion": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
          "source": "SdkVersion",
          "steps": [
              {
                  "regex": "^([0-9]+)(?:\\.[0-9]+){2}$",
                  "replacement": "$0"
              },
              {
                "regex": "^(latest|sts|11|11\\.0)$",
                "replacement": "11.0.100"
              },
              {
                "regex": "^(lts|10|10\\.0)$",
                "replacement": "10.0.404"
              },
              {
                "regex": "^(8|8\\.0)$",
                "replacement": "8.0.428"
              },
              {
                "regex": "^(9|9\\.0)$",
                "replacement": "9.0.321"
              }
          ]
      },
      "replaces": "__SdkVersion__"
    },
    "SdkMajor": {
        "type": "generated",
        "generator": "regex",
        "parameters": {
            "source": "NormalizedSdkVersion",
            "steps": [
                {
                    "regex": "^([0-9]+)(?:\\.[0-9]+){2}$",
                    "replacement": "$1"
                }
            ]
        }
    },
    "IsSdk8": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "SdkMajor",
        "pattern": "^8$"
      }
    },
    "IsSdk9": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "SdkMajor",
        "pattern": "^9$"
      }
    },
    "IsSdk10": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "SdkMajor",
        "pattern": "^10$"
      }
    },
    "IsSdk11": {
      "type": "generated",
      "generator": "regexMatch",
      "datatype": "bool",
      "parameters": {
        "source": "SdkMajor",
        "pattern": "^11$"
      }
    },
    "TargetFramework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0",
      "description": "Target framework",
      "choices": [
        {
          "choice": "net8.0",
          "description": ".NET 8 (out of support by Microsoft)"
        },
        {
          "choice": "net8",
          "description": ".NET 8 alias"
        },
        {
          "choice": "8",
          "description": ".NET 8 alias"
        },
        {
          "choice": "8.0",
          "description": ".NET 8 alias"
        },
        {
          "choice": "net9.0",
          "description": ".NET 9 (out of support by Microsoft)"
        },
        {
          "choice": "net9",
          "description": ".NET 9 alias"
        },
        {
          "choice": "9",
          "description": ".NET 9 alias"
        },
        {
          "choice": "9.0",
          "description": ".NET 9 alias"
        },
        {
          "choice": "net10.0",
          "description": ".NET 10 (recommended)"
        },
        {
          "choice": "net10",
          "description": ".NET 10 alias"
        },
        {
          "choice": "10",
          "description": ".NET 10 alias"
        },
        {
          "choice": "10.0",
          "description": ".NET 10 alias"
        },
        {
          "choice": "lts",
          "description": ".NET 10 alias"
        },
        {
          "choice": "net11.0",
          "description": ".NET 11 (recommended)"
        },
        {
          "choice": "net11",
          "description": ".NET 11 alias"
        },
        {
          "choice": "11",
          "description": ".NET 11 alias"
        },
        {
          "choice": "11.0",
          "description": ".NET 11 alias"
        },
        {
          "choice": "sts",
          "description": ".NET 11 alias"
        },
        {
          "choice": "latest",
          "description": ".NET 11 alias"
        }
      ]
    },
    "NormalizedTargetFramework": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "TargetFramework",
        "steps": [
          {
            "regex": "^(net11\\.0|net11|latest|sts|11|11\\.0)$",
            "replacement": "net11.0"
          },
          {
            "regex": "^(net10\\.0|net10|lts|10|10\\.0)$",
            "replacement": "net10.0"
          },
          {
            "regex": "^(net8\\.0|net8|8|8\\.0)$",
            "replacement": "net8.0"
          },
          {
            "regex": "^(net9\\.0|net9|9|9\\.0)$",
            "replacement": "net9.0"
          }
        ]
      },
      "replaces": "__TargetFramework__"
    },
    "BuildConfig": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include shared MSBuild and NuGet configuration"
    },
    "Preset": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "standard",
      "description": "Feature preset",
      "choices": [
        {
          "choice": "standard"
        },
        {
          "choice": "full"
        }
      ]
    },
    "TestRunner": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "VSTest",
      "description": "Test runner",
      "choices": [
        {
          "choice": "VSTest",
          "description": "Visual Studio Test"
        },
        {
          "choice": "MTP",
          "description": "Microsoft.Testing.Platform"
        }
      ]
    },
    "GitHubOwner": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "ownername",
      "description": "GitHub owner name",
      "replaces": "~~ownerName~~"
    },
    "License": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "MIT",
      "description": "License for GitHub repository",
      "choices": [
        {
          "choice": "MIT",
          "description": "MIT License"
        },
        {
          "choice": "ISC",
          "description": "ISC License"
        },
        {
          "choice": "Apache-2.0",
          "description": "Apache-2.0 License"
        },
        {
          "choice": "MPL-2.0",
          "description": "MPL-2.0 License"
        },
        {
          "choice": "BSD-2-Clause",
          "description": "BSD-2-Clause License"
        },
        {
          "choice": "BSD-3-Clause",
          "description": "BSD-3-Clause License"
        },
        {
          "choice": "GPL-2.0-only",
          "description": "GPL-2.0-only License"
        },
        {
          "choice": "GPL-3.0-only",
          "description": "GPL-3.0-only License"
        },
        {
          "choice": "AGPL-3.0-only",
          "description": "AGPL-3.0-only License"
        },
        {
          "choice": "LGPL-2.1-only",
          "description": "LGPL-2.1-only License"
        }
      ]
    },
    "NormalizedLicense": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "License",
        "steps": [
          {
            "regex": "(?i)^MIT$",
            "replacement": "MIT"
          },
          {
            "regex": "^(?i:Apache)\\-2\\.0$",
            "replacement": "Apache-2.0"
          },
          {
            "regex": "^(?i:BSD)\\-2\\-(?:Clause)$",
            "replacement": "BSD-2-Clause"
          },
          {
            "regex": "^(?i:BSD)\\-3\\-(?:Clause)$",
            "replacement": "BSD-3-Clause"
          },
          {
            "regex": "(?i)^ISC$",
            "replacement": "ISC"
          },
          {
            "regex": "^(?i:GPL)\\-2\\.0\\-(?:only)$",
            "replacement": "GPL-2.0-only"
          },
          {
            "regex": "^(?i:GPL)\\-3\\.0\\-(?:only)$",
            "replacement": "GPL-3.0-only"
          },
          {
            "regex": "^(?i:AGPL)\\-3\\.0\\-(?:only)$",
            "replacement": "AGPL-3.0-only"
          },
          {
            "regex": "^(?i:LGPL)\\-2\\.1\\-(?:only)$",
            "replacement": "LGPL-2.1-only"
          },
          {
            "regex": "^(?i:MPL)\\-2\\.0$",
            "replacement": "MPL-2.0"
          }
        ]
      },
      "replaces": "~~license~~"
    },
    "GitHubBadgeLicense": {
      "type": "derived",
      "valueSource": "NormalizedLicense",
      "valueTransform": "DoubleDashes",
      "replaces": "~~badgeLicense~~"
    },
    "CopyrightYear": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "<year>",
      "description": "Copyright year displayed in license",
      "replaces": "__CopyrightYear__"
    },
    "CopyrightOwner": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "<copyright owner>",
      "description": "Copyright owner displayed in license",
      "replaces": "__CopyrightOwner__"
    },
    "GitHubRepo": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "my-project",
      "description": "GitHub repository name",
      "replaces": "~~repoName~~"
    },
    "NormalizedBadgeRepo": {
      "type": "derived",
      "valueSource": "GitHubRepo",
      "valueTransform": "DoubleDashes",
      "replaces": "~~badgeRepoName~~"
    }
  },
  "forms": {
    "DoubleDashes": {
      "identifier": "replace",
      "pattern": "-",
      "replacement": "--"
    }
  },
  "specialCustomOperations": {
    "**/*.sln": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "endif": [ "#endif" ],
            "actionableIf": [ "#if" ],
            "actionableElse": [ "#else" ],
            "actionableElseif": [ "#elseif", "#elif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "endif": [ "#endif", "<!--#endif" ],
            "actionableIf": [ "<!--#if" ],
            "actionableElse": [ "#else", "<!--#else" ],
            "actionableElseif": [ "#elseif", "#elif", "<!--#elseif", "<!--#elif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.cs": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "endif": [ "#endif", "//#endif" ],
            "actionableIf": [ "//#if" ],
            "actionableElse": [ "#else", "//#else" ],
            "actionableElseif": [ "#elseif", "#elif", "//#elseif", "//#elif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "endif": [ "#endif", "<!--#endif" ],
            "actionableIf": [ "<!--#if" ],
            "actionableElse": [ "#else", "<!--#else" ],
            "actionableElseif": [ "#elseif", "#elif", "<!--#elseif", "<!--#elif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.json": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "endif": [ "#endif", "//#endif" ],
            "actionableIf": [ "//#if" ],
            "actionableElse": [ "#else", "//#else" ],
            "actionableElseif": [ "#elseif", "#elif", "//#elseif", "//#elif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        "solutions/**",
        "src/**",
        "tests/**",
        "benchmarks/**",
        "docs/**",
        ".github/**",
        "build-config/**",
        "global/**",
        "licenses/**",
        "**/bin/**",
        "**/obj/**",
        "**/.vs/**"
      ]
    },
    {
      "source": "solutions/dotnet-8/",
      "target": "./",
      "condition": "(IsSdk8)"
    },
    {
      "source": "solutions/dotnet-9+/",
      "target": "./",
      "condition": "(IsSdk9 || IsSdk10 || IsSdk11)"
    },
    {
      "source": "src/",
      "target": "src/",
      "modifiers": [
        {
          "condition": "(ProjectType == 'classlib' || ProjectType == 'class' || ProjectType == 'lib')",
          "exclude": [
            "**/Program.cs"
          ]
        }
      ],
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.vs/**"
      ]
    },
    {
      "source": "tests/",
      "target": "tests/",
      "condition": "(!Simple || Preset == 'full')",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.vs/**"
      ]
    },
    {
      "source": "benchmarks/",
      "target": "benchmarks/",
      "condition": "(Preset == 'full' || (!Simple && Benchmarks))",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.vs/**"
      ]
    },
    {
      "source": "docs/",
      "target": "docs/",
      "condition": "(Preset == 'full' || Docs)"
    },
    {
      "source": ".github/",
      "target": ".github/",
      "condition": "(Preset == 'full' || GitHubActions)"
    },
    {
      "source": "build-config/",
      "target": "./",
      "condition": "(Preset == 'full' || BuildConfig)"
    },
    {
      "source": "global/",
      "target": "./",
      "condition": "(Preset == 'full' || SdkVersion != '')"
    },
    {
      "source": "licenses/MIT/",
      "target": "./",
      "condition": "(NormalizedLicense == 'MIT')"
    },
    {
      "source": "licenses/Apache-2.0/",
      "target": "./",
      "condition": "(NormalizedLicense == 'Apache-2.0')"
    },
    {
      "source": "licenses/BSD-2-Clause/",
      "target": "./",
      "condition": "(NormalizedLicense == 'BSD-2-Clause')"
    },
    {
      "source": "licenses/BSD-3-Clause/",
      "target": "./",
      "condition": "(NormalizedLicense == 'BSD-3-Clause')"
    },
    {
      "source": "licenses/ISC/",
      "target": "./",
      "condition": "(NormalizedLicense == 'ISC')"
    },
    {
      "source": "licenses/GPL-2.0-only/",
      "target": "./",
      "condition": "(NormalizedLicense == 'GPL-2.0-only')"
    },
    {
      "source": "licenses/GPL-3.0-only/",
      "target": "./",
      "condition": "(NormalizedLicense == 'GPL-3.0-only')"
    },
    {
      "source": "licenses/LGPL-2.1-only/",
      "target": "./",
      "condition": "(NormalizedLicense == 'LGPL-2.1-only')"
    },
    {
      "source": "licenses/MPL-2.0/",
      "target": "./",
      "condition": "(NormalizedLicense == 'MPL-2.0')"
    },
    {
      "source": "licenses/AGPL-3.0-only/",
      "target": "./",
      "condition": "(NormalizedLicense == 'AGPL-3.0-only')"
    }
  ]
}