{
  "$schema": "https://json.schemastore.org/template",
  "author": "LanDX",
  "classifications": [
    "Library",
    "C#",
    "Solution"
  ],
  "identity": "LanDX.Templates",
  "name": "LanDX Templates",
  "shortName": "landx-templates",
  "sourceName": "MyNamespace.MyProject",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "ProjectType": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "classlib",
      "description": "Main project type",
      "choices": [
        {
          "choice": "classlib",
          "description": "Class Library (recommended)"
        },
        {
          "choice": "class",
          "description": "Class Library alias"
        },
        {
          "choice": "lib",
          "description": "Class Library alias"
        },
        {
          "choice": "console",
          "description": "Console Application"
        }
      ]
    },
    "Simple": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Generate only the main project"
    },
    "Benchmarks": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include BenchmarkDotNet project"
    },
    "Docs": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include documentation"
    },
    "GitHubActions": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include GitHub Actions workflow"
    },
    "SdkVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Optional .NET SDK version for global.json"
    },
    "NormalizedSdkVersion": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "SdkVersion",
        "steps": [
          {
            "regex": "^(latest|sts|11|11\\.0)$",
            "replacement": "11.0.100"
          },
          {
            "regex": "^(lts|10|10\\.0)$",
            "replacement": "10.0.404"
          },
          {
            "regex": "^(8|8\\.0)$",
            "replacement": "8.0.428"
          },
          {
            "regex": "^(9|9\\.0)$",
            "replacement": "9.0.321"
          }
        ]
      }
    },
    "TargetFramework": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "net10.0",
      "description": "Target framework",
      "choices": [
        {
          "choice": "net8.0",
          "description": ".NET 8 (out of support by Microsoft)"
        },
        {
          "choice": "net8",
          "description": ".NET 8 alias"
        },
        {
          "choice": "8",
          "description": ".NET 8 alias"
        },
        {
          "choice": "8.0",
          "description": ".NET 8 alias"
        },
        {
          "choice": "net9.0",
          "description": ".NET 9 (out of support by Microsoft)"
        },
        {
          "choice": "net9",
          "description": ".NET 9 alias"
        },
        {
          "choice": "9",
          "description": ".NET 9 alias"
        },
        {
          "choice": "9.0",
          "description": ".NET 9 alias"
        },
        {
          "choice": "net10.0",
          "description": ".NET 10 (recommended)"
        },
        {
          "choice": "net10",
          "description": ".NET 10 alias"
        },
        {
          "choice": "10",
          "description": ".NET 10 alias"
        },
        {
          "choice": "10.0",
          "description": ".NET 10 alias"
        },
        {
          "choice": "lts",
          "description": ".NET 10 alias"
        },
        {
          "choice": "net11.0",
          "description": ".NET 11 (recommended)"
        },
        {
          "choice": "net11",
          "description": ".NET 11 alias"
        },
        {
          "choice": "11",
          "description": ".NET 11 alias"
        },
        {
          "choice": "11.0",
          "description": ".NET 11 alias"
        },
        {
          "choice": "sts",
          "description": ".NET 11 alias"
        },
        {
          "choice": "latest",
          "description": ".NET 11 alias"
        }
      ]
    },
    "NormalizedTargetFramework": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "TargetFramework",
        "steps": [
          {
            "regex": "^(net11\\.0|net11|latest|sts|11|11\\.0)$",
            "replacement": "net11.0"
          },
          {
            "regex": "^(net10\\.0|net10|lts|10|10\\.0)$",
            "replacement": "net10.0"
          },
          {
            "regex": "^(net8\\.0|net8|8|8\\.0)$",
            "replacement": "net8.0"
          },
          {
            "regex": "^(net9\\.0|net9|9|9\\.0)$",
            "replacement": "net9.0"
          }
        ]
      }
    },
    "Version": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "Unified .NET version (latest, lts, sts, 8, 9, 10, 11)"
    },
    "VersionTargetFramework": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(Version == 'latest' || Version == 'sts' || Version == '11' || Version == '11.0')",
            "value": "net11.0"
          },
          {
            "condition": "(Version == 'lts' || Version == '10' || Version == '10.0')",
            "value": "net10.0"
          },
          {
            "condition": "(Version == '9' || Version == '9.0')",
            "value": "net9.0"
          },
          {
            "condition": "(Version == '8' || Version == '8.0')",
            "value": "net8.0"
          }
        ]
      }
    },
    "VersionSdkVersion": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          {
            "condition": "(Version == 'latest' || Version == 'sts' || Version == '11' || Version == '11.0')",
            "value": "11.0.100"
          },
          {
            "condition": "(Version == 'lts' || Version == '10' || Version == '10.0')",
            "value": "10.0.404"
          },
          {
            "condition": "(Version == '9' || Version == '9.0')",
            "value": "9.0.321"
          },
          {
            "condition": "(Version == '8' || Version == '8.0')",
            "value": "8.0.428"
          }
        ]
      }
    },
    "EffectiveTargetFramework": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "VersionTargetFramework",
        "fallbackVariableName": "NormalizedTargetFramework"
      },
      "replaces": "__TargetFramework__"
    },
    "EffectiveSdkVersion": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "VersionSdkVersion",
        "fallbackVariableName": "NormalizedSdkVersion"
      },
      "replaces": "__SdkVersion__"
    },
    "BuildConfig": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Include shared MSBuild and NuGet configuration"
    },
    "Preset": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "standard",
      "description": "Feature preset",
      "choices": [
        {
          "choice": "standard"
        },
        {
          "choice": "full"
        }
      ]
    },
    "GitHubOwner": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "ownername",
      "description": "GitHub owner name",
      "replaces": "~~ownerName~~"
    },
    "License": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "MIT",
      "description": "License for GitHub repository",
      "choices": [
        {
          "choice": "MIT",
          "description": "MIT License"
        },
        {
          "choice": "mit",
          "description": "MIT License"
        },
        {
          "choice": "ISC",
          "description": "ISC License"
        },
        {
          "choice": "isc",
          "description": "ISC License"
        },
        {
          "choice": "Apache-2.0",
          "description": "Apache-2.0 License"
        },
        {
          "choice": "apache-2.0",
          "description": "Apache-2.0 License"
        },
        {
          "choice": "MPL-2.0",
          "description": "MPL-2.0 License"
        },
        {
          "choice": "mpl-2.0",
          "description": "MPL-2.0 License"
        },
        {
          "choice": "BSD-2-Clause",
          "description": "BSD-2-Clause License"
        },
        {
          "choice": "bsd-2-clause",
          "description": "BSD-2-Clause License"
        },
        {
          "choice": "BSD-3-Clause",
          "description": "BSD-3-Clause License"
        },
        {
          "choice": "bsd-3-clause",
          "description": "BSD-3-Clause License"
        },
        {
          "choice": "GPL-2.0-only",
          "description": "GPL-2.0-only License"
        },
        {
          "choice": "gpl-2.0-only",
          "description": "GPL-2.0-only License"
        },
        {
          "choice": "GPL-3.0-only",
          "description": "GPL-3.0-only License"
        },
        {
          "choice": "gpl-3.0-only",
          "description": "GPL-3.0-only License"
        },
        {
          "choice": "AGPL-3.0-only",
          "description": "AGPL-3.0-only License"
        },
        {
          "choice": "agpl-3.0-only",
          "description": "AGPL-3.0-only License"
        },
        {
          "choice": "LGPL-2.1-only",
          "description": "LGPL-2.1-only License"
        },
        {
          "choice": "lgpl-2.1-only",
          "description": "LGPL-2.1-only License"
        }
      ]
    },
    "NormalizedLicense": {
      "type": "generated",
      "generator": "regex",
      "parameters": {
        "source": "License",
        "steps": [
          {
            "regex": "(?i)^MIT$",
            "replacement": "MIT"
          },
          {
            "regex": "^(?i:Apache)\\-2\\.0$",
            "replacement": "Apache-2.0"
          },
          {
            "regex": "^(?i:BSD)\\-2\\-(?:Clause)$",
            "replacement": "BSD-2-Clause"
          },
          {
            "regex": "^(?i:BSD)\\-3\\-(?:Clause)$",
            "replacement": "BSD-3-Clause"
          },
          {
            "regex": "(?i)^ISC$",
            "replacement": "ISC"
          },
          {
            "regex": "^(?i:GPL)\\-2\\.0\\-(?:only)$",
            "replacement": "GPL-2.0-only"
          },
          {
            "regex": "^(?i:GPL)\\-3\\.0\\-(?:only)$",
            "replacement": "GPL-3.0-only"
          },
          {
            "regex": "^(?i:AGPL)\\-3\\.0\\-(?:only)$",
            "replacement": "AGPL-3.0-only"
          },
          {
            "regex": "^(?i:LGPL)\\-2\\.1\\-(?:only)$",
            "replacement": "LGPL-2.1-only"
          },
          {
            "regex": "^(?i:MPL)\\-2\\.0$",
            "replacement": "MPL-2.0"
          }
        ]
      },
      "replaces": "~~license~~"
    },
    "GitHubBadgeLicense": {
      "type": "derived",
      "valueSource": "NormalizedLicense",
      "valueTransform": "DoubleDashes",
      "replaces": "~~badgeLicense~~"
    },
    "CopyrightYear": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "<year>",
      "description": "Copyright year displayed in license",
      "replaces": "__CopyrightYear__"
    },
    "CopyrightOwner": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "<copyright owner>",
      "description": "Copyright owner displayed in license",
      "replaces": "__CopyrightOwner__"
    },
    "GitHubRepo": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "my-project",
      "description": "GitHub repository name",
      "replaces": "~~repoName~~"
    },
    "NormalizedBadgeRepo": {
      "type": "derived",
      "valueSource": "GitHubRepo",
      "valueTransform": "DoubleDashes",
      "replaces": "~~badgeRepoName~~"
    }
  },
  "forms": {
    "DoubleDashes": {
      "identifier": "replace",
      "pattern": "-",
      "replacement": "--"
    }
  },
  "specialCustomOperations": {
    "**/*.slnx": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "endif": [ "#endif", "<!--#endif" ],
            "actionableIf": [ "<!--#if" ],
            "actionableElse": [ "#else", "<!--#else" ],
            "actionableElseif": [ "#elseif", "#elif", "<!--#elseif", "<!--#elif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.cs": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "endif": [ "#endif", "//#endif" ],
            "actionableIf": [ "//#if" ],
            "actionableElse": [ "#else", "//#else" ],
            "actionableElseif": [ "#elseif", "#elif", "//#elseif", "//#elif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.md": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "endif": [ "#endif", "<!--#endif" ],
            "actionableIf": [ "<!--#if" ],
            "actionableElse": [ "#else", "<!--#else" ],
            "actionableElseif": [ "#elseif", "#elif", "<!--#elseif", "<!--#elif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.json": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "endif": [ "#endif", "//#endif" ],
            "actionableIf": [ "//#if" ],
            "actionableElse": [ "#else", "//#else" ],
            "actionableElseif": [ "#elseif", "#elif", "//#elseif", "//#elif" ],
            "trim": "true",
            "wholeLine": "true",
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [
        ".template.config/**",
        "src/**",
        "tests/**",
        "benchmarks/**",
        "docs/**",
        ".github/**",
        "build-config/**",
        "global/**",
        "licenses/**",
        "**/bin/**",
        "**/obj/**",
        "**/.vs/**"
      ]
    },
    {
      "source": "src/",
      "target": "src/",
      "modifiers": [
        {
          "condition": "(ProjectType == 'classlib' || ProjectType == 'class' || ProjectType == 'lib')",
          "exclude": [
            "**/Program.cs"
          ]
        }
      ]
    },
    {
      "source": "tests/",
      "target": "tests/",
      "condition": "(!Simple || Preset == 'full')"
    },
    {
      "source": "benchmarks/",
      "target": "benchmarks/",
      "condition": "(Preset == 'full' || (!Simple && Benchmarks))"
    },
    {
      "source": "docs/",
      "target": "docs/",
      "condition": "(Preset == 'full' || Docs)"
    },
    {
      "source": ".github/",
      "target": ".github/",
      "condition": "(Preset == 'full' || GitHubActions)"
    },
    {
      "source": "build-config/",
      "target": "./",
      "condition": "(Preset == 'full' || BuildConfig)"
    },
    {
      "source": "global/",
      "target": "./",
      "condition": "(Preset == 'full' || Version != '' || SdkVersion != '')"
    },
    {
      "source": "licenses/MIT/",
      "target": "./",
      "condition": "(NormalizedLicense == 'MIT')"
    },
    {
      "source": "licenses/Apache-2.0/",
      "target": "./",
      "condition": "(NormalizedLicense == 'Apache-2.0')"
    },
    {
      "source": "licenses/BSD-2-Clause/",
      "target": "./",
      "condition": "(NormalizedLicense == 'BSD-2-Clause')"
    },
    {
      "source": "licenses/BSD-3-Clause/",
      "target": "./",
      "condition": "(NormalizedLicense == 'BSD-3-Clause')"
    },
    {
      "source": "licenses/ISC/",
      "target": "./",
      "condition": "(NormalizedLicense == 'ISC')"
    },
    {
      "source": "licenses/GPL-2.0-only/",
      "target": "./",
      "condition": "(NormalizedLicense == 'GPL-2.0-only')"
    },
    {
      "source": "licenses/GPL-3.0-only/",
      "target": "./",
      "condition": "(NormalizedLicense == 'GPL-3.0-only')"
    },
    {
      "source": "licenses/LGPL-2.1-only/",
      "target": "./",
      "condition": "(NormalizedLicense == 'LGPL-2.1-only')"
    },
    {
      "source": "licenses/MPL-2.0/",
      "target": "./",
      "condition": "(NormalizedLicense == 'MPL-2.0')"
    },
    {
      "source": "licenses/AGPL-3.0-only/",
      "target": "./",
      "condition": "(NormalizedLicense == 'AGPL-3.0-only')"
    }
  ]
}